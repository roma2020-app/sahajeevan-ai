# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_MAPS_API_KEY: Google Maps Platform API key (for Maps JavaScript API and Advanced Markers).
# In production on Google Cloud Run (service: sahajeevan, project: peta-idea-jlcf1),
# this secret is stored in Google Cloud Secret Manager and mounted as an environment variable:
#   gcloud secrets create GOOGLE_MAPS_API_KEY --data-file=- --project=peta-idea-jlcf1
#   gcloud run services update sahajeevan --set-secrets="GOOGLE_MAPS_API_KEY=GOOGLE_MAPS_API_KEY:latest"
# Security Requirements:
# 1. Restrict API key to 'Maps JavaScript API' only in Google Cloud Console.
# 2. Add HTTP referrer restrictions (e.g., https://sahajeevan-61315710877.asia-southeast1.run.app/*).
GOOGLE_MAPS_API_KEY=""

